# mock (default): fully offline on fixtures, no keys needed
# live: real APIs; any service missing its key falls back to mock on its own
MODE=mock

# GitHub: a personal access token (public repo read is enough)
GITHUB_TOKEN=

# LLM: drafts, claim detection, why-chips
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# FalkorDB: graph + Redis cache (docker compose up -d)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
GRAPH_NAME=breadcrumbs
